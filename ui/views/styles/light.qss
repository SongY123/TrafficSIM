QMainWindow, QWidget {
  background: #f2f3f5;
  color: #606266;
  font-family: "__TRAFFICVERSE_UI_FONT__";
  font-size: 13px;
}
QLabel, QCheckBox { background: transparent; }
QToolTip { background: #303133; color: #ffffff; border: 1px solid #303133; padding: 6px 8px; }
QWidget#appShell, QWidget#pageStack { background: #f2f3f5; }
QWidget#navigationRail { background: #ffffff; border-right: 1px solid #dcdfe6; }
QWidget#workspaceNavigationRail { background: #ffffff; border-right: 1px solid #dcdfe6; }
QWidget#navigationStack { background: #ffffff; }
QLabel#brandLogo { background: transparent; }
QLabel#brandName { color: #303133; font-size: 16px; font-weight: 600; }
QLabel#brandCaption, QLabel#caption, QLabel#fieldLabel, QLabel#metricLabel { color: #909399; }
QLabel#sectionLabel { color: #a8abb2; font-size: 11px; font-weight: 500; }
QLabel#navigationGroupLabel {
  color: #909399; font-size: 13px; font-weight: 600; padding: 5px 12px 3px 12px;
}
QLabel#workspaceSectionTitle { color: #606266; font-size: 14px; font-weight: 600; }
QPushButton#activeWorkspaceName {
  background: transparent; border: 0; color: #303133; font-size: 15px; font-weight: 600;
  padding: 6px 12px; text-align: left;
}
QPushButton#activeWorkspaceName:hover { background: #ecf5ff; color: #409eff; }
QPushButton#workspaceBackButton {
  background: transparent; border: 0; color: #909399; padding: 7px 10px; text-align: left;
}
QPushButton#workspaceBackButton:hover { color: #409eff; background: #ecf5ff; }
QPushButton#workspaceCreateButton {
  background: transparent; border: 1px solid #79bbff; color: #409eff;
  padding: 0; font-size: 19px; font-weight: 500;
}
QPushButton#workspaceCreateButton:hover { background: #ecf5ff; border-color: #409eff; }
QLineEdit#workspaceSearchInput { background: #f5f7fa; padding: 9px 10px; }
QListWidget#workspaceList { background: transparent; border: 0; color: #606266; outline: 0; }
QListWidget#workspaceList::item {
  border-left: 3px solid transparent; padding: 0; margin: 1px 0;
}
QListWidget#workspaceList::item:hover { background: #f5f7fa; color: #303133; }
QListWidget#workspaceList::item:selected {
  background: #ecf5ff; border-left-color: #409eff; color: #409eff;
}
QWidget#workspaceListRow { background: transparent; }
QWidget#workspaceListRow QLabel#workspaceListName {
  color: #606266; font-size: 15px;
}
QWidget#workspaceListRow[active="true"] QLabel#workspaceListName { color: #409eff; }
QPushButton#workspaceListDeleteButton {
  background: #fef0f0; border: 1px solid #fbc4c4; color: #f56c6c;
  padding: 3px 7px; font-size: 11px;
}
QPushButton#workspaceListDeleteButton:hover {
  background: #f56c6c; border-color: #f56c6c; color: #ffffff;
}
QPushButton#workspaceSettingsButton {
  background: transparent; border: 0; border-top: 1px solid #dcdfe6;
  border-radius: 0; color: #606266; padding: 14px 10px; text-align: left;
}
QPushButton[role="navigation"] {
  background: transparent; border: 0; border-left: 3px solid transparent;
  border-radius: 0; color: #606266; padding: 10px 16px;
  text-align: left; font-size: 15px; font-weight: 400;
}
QPushButton[role="navigation"]:hover { background: #f5f7fa; color: #303133; }
QPushButton[role="navigation"][active="true"] {
  background: #ecf5ff; border-left-color: #409eff; color: #409eff; font-weight: 500;
}
QWidget[role="navigationRow"] {
  background: transparent; border: 0; border-left: 3px solid transparent;
}
QWidget[role="navigationRow"][hovered="true"] { background: #f5f7fa; }
QWidget[role="navigationRow"][active="true"] {
  background: #ecf5ff; border-left-color: #409eff;
}
QPushButton[role="navigationRowMain"] {
  background: transparent; border: 0; border-radius: 0; color: #606266;
  padding: 10px 13px; text-align: left; font-size: 15px; font-weight: 400;
}
QPushButton[role="navigationExpand"] {
  background: transparent; border: 0; border-radius: 0; color: #a8abb2;
  padding: 0; font-size: 18px;
}
QPushButton[role="navigationExpand"]:hover { background: transparent; }
QWidget[role="navigationRow"][hovered="true"] QPushButton { color: #303133; }
QWidget[role="navigationRow"][active="true"] QPushButton { color: #409eff; }
QPushButton[role="subnavigation"] {
  background: transparent; border: 0; border-left: 3px solid transparent;
  border-radius: 0; color: #909399; padding: 8px 16px 8px 46px;
  text-align: left; font-size: 13px;
}
QPushButton[role="subnavigation"]:hover { background: #f5f7fa; color: #303133; }
QPushButton[role="subnavigation"][active="true"] { color: #409eff; }
QFrame#navigationDivider { background: #dcdfe6; border: 0; max-height: 1px; }
QFrame#topBar { background: #ffffff; border-bottom: 1px solid #dcdfe6; }
QLabel#pageTitle { color: #303133; font-size: 20px; font-weight: 600; }
QLabel#pageSubtitle { color: #909399; font-size: 12px; }
QLabel#mono, QLabel#metricValue, QLabel#statusValue {
  font-family: "__TRAFFICVERSE_MONO_FONT__";
}
QLabel#metricValue { color: #303133; font-size: 21px; font-weight: 600; }
AutomationLevelBarChart {
  qproperty-l0Color: #e05151; qproperty-l1Color: #d57f1c; qproperty-l2Color: #d3aa19;
  qproperty-l3Color: #247bd8; qproperty-l4Color: #4ea624; qproperty-l5Color: #8563e0;
}
QLabel#statusBadge {
  background: #f0f9eb; border: 1px solid #c2e7b0; border-radius: 4px;
  color: #67c23a; padding: 5px 9px; font-size: 12px; font-weight: 500;
}
QLabel#connectionBadge {
  background: #ecf5ff; border: 1px solid #b3d8ff; border-radius: 4px;
  color: #409eff; padding: 5px 9px;
}
QLabel#notice {
  background: #ecf5ff; border: 1px solid #b3d8ff; border-radius: 4px;
  color: #409eff; padding: 9px 12px;
}
QLabel#notice[level="error"] { background: #fef0f0; border-color: #fbc4c4; color: #f56c6c; }
QLabel#notice[level="success"] { background: #f0f9eb; border-color: #c2e7b0; color: #67c23a; }
QLabel#notice[level="warning"] { background: #fdf6ec; border-color: #f5dab1; color: #e6a23c; }
QFrame#panel, QFrame#metricCard, QFrame#listCard, QFrame#assetDirectory {
  background: #ffffff; border: 1px solid #dcdfe6; border-radius: 4px;
}
QFrame#workspacePreview {
  background: #ffffff; border: 1px solid #dcdfe6; border-radius: 6px;
  min-height: 300px;
}
QFrame#projectEditableField {
  background: #fafafa; border: 1px solid #e4e7ed; border-radius: 4px;
}
QFrame#projectEditableField:hover, QFrame#projectEditableField:focus {
  background: #ecf5ff; border-color: #409eff;
}
QLabel#projectFieldLabel { color: #909399; font-size: 12px; }
QLabel#projectNameValue { color: #303133; font-size: 18px; font-weight: 600; }
QLabel#projectDescriptionValue { color: #606266; font-size: 14px; }
QWidget#projectSimulationActions { background: transparent; }
QToolButton#projectSimulationAction {
  background: transparent; border: 0; border-radius: 4px; padding: 4px;
}
QToolButton#projectSimulationAction:hover { background: #f5f7fa; }
QLabel#projectSimulationStatus { font-size: 12px; font-weight: 500; }
QLabel#projectSimulationStatus[state="running"] { color: #409eff; }
QLabel#projectSimulationStatus[state="completed"] { color: #67c23a; }
QLabel#projectSimulationStatus[state="failed"] { color: #f56c6c; }
QWidget#simulationConfigurationBody, QFrame#simulationConfigurationSection,
QFrame#simulationRightColumn { background: transparent; border: 0; }
QLabel#simulationSectionTitle { color: #909399; font-size: 11px; font-weight: 600; }
QLabel#simulationFieldLabel { color: #606266; font-size: 11px; font-weight: 500; }
QLineEdit#sceneNameInput, QTextEdit#sceneDescriptionInput {
  background: #ffffff; border-color: #cdd0d6; color: #303133; font-size: 13px;
}
QLineEdit#sceneNameInput:focus, QTextEdit#sceneDescriptionInput:focus { border-color: #409eff; }
QFrame#automationConfigurationRow {
  background: #ffffff; border: 1px solid #dcdfe6; border-radius: 4px;
}
QFrame#automationConfigurationRow QComboBox,
QFrame#automationConfigurationRow QSpinBox { background: #fafafa; }
QSpinBox#automationVehicleCount { padding-right: 38px; qproperty-arrowColor: #606266; }
QSpinBox#automationVehicleCount::up-button,
QSpinBox#automationVehicleCount::down-button {
  subcontrol-origin: border; width: 34px; border-left: 1px solid #dcdfe6;
}
QSpinBox#automationVehicleCount::up-button {
  subcontrol-position: top right; border-bottom: 1px solid #dcdfe6;
}
QSpinBox#automationVehicleCount::down-button { subcontrol-position: bottom right; }
QSpinBox#automationVehicleCount::up-arrow,
QSpinBox#automationVehicleCount::down-arrow { image: none; width: 0; height: 0; }
QSpinBox#automationVehicleCount::up-button:hover,
QSpinBox#automationVehicleCount::down-button:hover { background: #ecf5ff; }
QSpinBox#automationVehicleCount[macosStepper="true"] { padding-right: 44px; }
QSpinBox#automationVehicleCount[macosStepper="true"]::up-button,
QSpinBox#automationVehicleCount[macosStepper="true"]::down-button { width: 40px; }
QPushButton#automationRowAction { min-width: 28px; max-width: 28px; padding: 6px 0; }
QPushButton#automationRowAction[action="remove"] { color: #909399; }
QPushButton#addAutomationCategoryButton {
  background: transparent; border: 1px dashed #cdd0d6; color: #909399; padding: 9px;
}
QPushButton#addAutomationCategoryButton:hover { border-color: #409eff; color: #409eff; }
QLabel#automationTotal {
  background: #e6fffb; border: 1px solid #87e8de; border-radius: 3px;
  color: #08979c; padding: 3px 7px; font-family: "__TRAFFICVERSE_MONO_FONT__";
}
QWebEngineView#simulationMapPreview {
  background: #eef1f4; border: 1px solid #cdd0d6; border-radius: 4px;
}
QLabel#simulationMapStatus { color: #909399; font-size: 11px; }
QTimeEdit#simulationDurationTime {
  background: #ffffff; border: 1px solid #cdd0d6; border-radius: 4px;
  color: #303133; padding: 7px 12px; font-family: "__TRAFFICVERSE_MONO_FONT__";
}
QTimeEdit#simulationDurationTime:hover, QTimeEdit#simulationDurationTime:focus {
  border-color: #409eff;
}
QLabel#dialogTitle { color: #303133; font-size: 19px; font-weight: 600; }
QLabel#workspaceDeleteError {
  background: #fef0f0; border: 1px solid #fbc4c4; border-radius: 4px;
  color: #f56c6c; padding: 7px 9px;
}
QDialog#workspaceEditDialog, QDialog#workspaceDeleteDialog {
  background: #ffffff; border: 1px solid #dcdfe6;
}
QFrame#panelAccent { background: #ffffff; border: 1px solid #a0cfff; border-radius: 4px; }
QLabel#panelTitle { color: #303133; font-size: 14px; font-weight: 600; }
QLabel#panelKicker { color: #909399; font-size: 11px; font-weight: 500; }
QLabel#compatibilityTag {
  background: #ecf5ff; border: 1px solid #b3d8ff; border-radius: 4px;
  color: #409eff; padding: 5px 9px;
}
QLabel#assetStatusBadge {
  background: #f0f9eb; border: 1px solid #c2e7b0; border-radius: 4px;
  color: #67c23a; padding: 5px 9px;
}
QLabel#emptyIcon { color: #c0c4cc; font-size: 40px; font-weight: 500; }
QLabel#emptyTitle { color: #606266; font-size: 17px; font-weight: 500; }
QLabel#carlaStatus { background: #f5f7fa; color: #909399; border-radius: 4px; }
QPushButton, QComboBox, QLineEdit, QTextEdit, QSpinBox, QDoubleSpinBox {
  background: #ffffff; border: 1px solid #dcdfe6; border-radius: 4px;
  color: #606266; padding: 7px 12px; selection-background-color: #a0cfff;
}
QPushButton:hover, QComboBox:hover, QLineEdit:hover, QTextEdit:hover,
QSpinBox:hover, QDoubleSpinBox:hover { border-color: #409eff; }
QPushButton:pressed { background: #f5f7fa; }
QPushButton:disabled { color: #c0c4cc; background: #f5f7fa; border-color: #e4e7ed; }
QPushButton#primaryButton { background: #409eff; border-color: #409eff; color: #ffffff; font-weight: 500; }
QPushButton#primaryButton:hover { background: #79bbff; border-color: #79bbff; }
QPushButton[role="primaryAction"] { background: #409eff; border-color: #409eff; color: #ffffff; font-weight: 500; }
QPushButton[role="primaryAction"]:hover { background: #79bbff; border-color: #79bbff; }
QPushButton#dangerButton { background: #fef0f0; border-color: #fbc4c4; color: #f56c6c; }
QPushButton#dangerButton:hover { background: #f56c6c; border-color: #f56c6c; color: #ffffff; }
QPushButton#restartButton { background: #fdf6ec; border-color: #f5dab1; color: #e6a23c; }
QPushButton#restartButton:hover { background: #e6a23c; border-color: #e6a23c; color: #ffffff; }
QPushButton#speedButton { padding: 6px 11px; }
QPushButton#speedButton:checked { background: #ecf5ff; border-color: #409eff; color: #409eff; }
QComboBox::drop-down { border: 0; width: 24px; }
QComboBox QAbstractItemView { background: #ffffff; border: 1px solid #dcdfe6; selection-background-color: #ecf5ff; }
QScrollArea { border: 0; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }
QSplitter::handle { background: #e4e7ed; width: 8px; }
QProgressBar { background: #ebeef5; border: 0; border-radius: 2px; max-height: 4px; }
QProgressBar::chunk { background: #409eff; border-radius: 2px; }
QTableWidget {
  background: #ffffff; alternate-background-color: #fafafa;
  border: 1px solid #dcdfe6; border-radius: 4px;
  gridline-color: #ebeef5; color: #606266;
}
QTableWidget#projectSimulationTable { min-height: 280px; }
QTreeWidget {
  background: #ffffff; alternate-background-color: #fafafa;
  border: 1px solid #dcdfe6; border-radius: 4px; color: #606266;
}
QTreeWidget::item { padding: 5px 4px; }
QTreeWidget::item:hover { background: #f5f7fa; }
QTreeWidget::item:selected { background: #ecf5ff; color: #409eff; }
QHeaderView::section {
  background: #f5f7fa; border: 0; border-bottom: 1px solid #dcdfe6;
  color: #909399; padding: 8px; font-weight: 500;
}
QTabWidget::pane { border: 1px solid #dcdfe6; border-radius: 4px; }
QTabBar::tab { background: #ffffff; color: #909399; padding: 8px 14px; }
QTabBar::tab:selected { color: #409eff; border-bottom: 2px solid #409eff; }

QPushButton[role="historyEntry"] {
  background: transparent; border: 0; border-left: 1px solid #dcdfe6;
  border-radius: 0; color: #909399; padding: 7px 5px 7px 25px;
  text-align: left; font-size: 12px; font-family: "__TRAFFICVERSE_MONO_FONT__";
}
QPushButton[role="historyEntry"]:hover { background: #f5f7fa; color: #606266; }
QPushButton[role="historyEntry"][active="true"] {
  background: #ecf5ff; border: 1px solid #b3d8ff; border-left: 3px solid #409eff;
  border-radius: 4px; color: #303133; font-weight: 600;
}
QWidget#dataReplayPage, QWidget#replayBody { background: #f2f3f5; }
QLabel#replayTimestamp {
  background: #ecf5ff; border: 1px solid #b3d8ff; border-radius: 6px;
  color: #1686a0; padding: 7px 11px; font-family: "__TRAFFICVERSE_MONO_FONT__";
  font-size: 12px; font-weight: 600;
}
QPushButton#replayRestartButton, QPushButton#replayBackButton, QPushButton#replayExportButton {
  padding: 8px 14px; font-weight: 600;
}
QFrame#replaySummaryBar, QFrame#replaySection {
  background: #ffffff; border: 1px solid #dcdfe6; border-radius: 10px;
}
QWidget#replaySummaryItem { background: transparent; border-right: 1px solid #e4e7ed; }
QLabel#replaySummaryLabel, QLabel#replayMetricLabel, QLabel#replayMetricUnit,
QLabel#replayChartRange { color: #909399; font-size: 11px; }
QLabel#replaySummaryValue {
  color: #303133; font-size: 12px; font-weight: 600;
  font-family: "__TRAFFICVERSE_MONO_FONT__";
}
QLabel#replaySummaryValue[summaryKey="duration"] { color: #1686a0; font-size: 15px; }
QLabel#replaySummaryValue[summaryKey="status"] { color: #67c23a; }
QLabel#replaySectionTitle { color: #303133; font-size: 16px; font-weight: 700; }
QFrame#replayMetricCard, QFrame#replayChartCard {
  background: #fafafa; border: 1px solid #e4e7ed; border-radius: 8px;
}
QLabel#replayMetricValue {
  color: #303133; font-size: 25px; font-weight: 700;
  font-family: "__TRAFFICVERSE_MONO_FONT__";
}
QLabel#replayMetricValue[tone="primary"] { color: #1686a0; }
QLabel#replayMetricValue[tone="warning"] { color: #e26d4f; }
QLabel#replayChartTitle { color: #303133; font-size: 12px; font-weight: 600; }
QFrame#replayTrendChart { background: transparent; border: 0; }
QFrame#replayRoadCanvas {
  background: #eef2f7; border: 1px solid #d5dbe5; border-radius: 8px;
}
QPushButton#replayMapModeButton {
  background: #f5f7fa; border: 1px solid #dcdfe6; color: #606266;
  padding: 6px 9px; font-size: 11px;
}
QPushButton#replayMapModeButton:checked {
  background: #ecf5ff; border-color: #79bbff; color: #409eff;
}
