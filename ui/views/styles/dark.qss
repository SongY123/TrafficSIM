QMainWindow, QWidget {
  background: #141414;
  color: #cfd3dc;
  font-family: "__TRAFFICVERSE_UI_FONT__";
  font-size: 13px;
}
QLabel, QCheckBox { background: transparent; }
QToolTip { background: #303133; color: #e5eaf3; border: 1px solid #4c4d4f; padding: 6px 8px; }
QWidget#appShell, QWidget#pageStack { background: #141414; }
QWidget#navigationRail { background: #1d1e1f; border-right: 1px solid #414243; }
QWidget#workspaceNavigationRail { background: #0f121a; border-right: 1px solid #353947; }
QWidget#navigationStack { background: #0f121a; }
QLabel#brandLogo { background: transparent; }
QLabel#brandName { color: #e5eaf3; font-size: 16px; font-weight: 600; }
QLabel#brandCaption, QLabel#caption, QLabel#fieldLabel, QLabel#metricLabel { color: #a3a6ad; }
QLabel#sectionLabel { color: #8d9095; font-size: 11px; font-weight: 500; }
QLabel#navigationGroupLabel {
  color: #8d9095; font-size: 13px; font-weight: 600; padding: 5px 12px 3px 12px;
}
QLabel#workspaceSectionTitle { color: #cfd3dc; font-size: 14px; font-weight: 600; }
QPushButton#activeWorkspaceName {
  background: transparent; border: 0; color: #e5eaf3; font-size: 15px; font-weight: 600;
  padding: 6px 12px; text-align: left;
}
QPushButton#activeWorkspaceName:hover { background: #18222c; color: #409eff; }
QPushButton#workspaceBackButton {
  background: transparent; border: 0; color: #a3a6ad; padding: 7px 10px; text-align: left;
}
QPushButton#workspaceBackButton:hover { color: #409eff; background: #18222c; }
QPushButton#workspaceCreateButton {
  background: transparent; border: 1px solid #3375b9; color: #79bbff;
  padding: 0; font-size: 19px; font-weight: 500;
}
QPushButton#workspaceCreateButton:hover { background: #18222c; border-color: #409eff; }
QLineEdit#workspaceSearchInput { background: #171a23; padding: 9px 10px; }
QListWidget#workspaceList {
  background: transparent; border: 0; color: #cfd3dc; outline: 0;
}
QListWidget#workspaceList::item {
  border-left: 3px solid transparent; padding: 0; margin: 1px 0;
}
QListWidget#workspaceList::item:hover { background: #191d27; color: #e5eaf3; }
QListWidget#workspaceList::item:selected {
  background: #151d2e; border-left-color: #b3c5ff; color: #b3c5ff;
}
QWidget#workspaceListRow { background: transparent; }
QWidget#workspaceListRow QLabel#workspaceListName {
  color: #cfd3dc; font-size: 15px;
}
QWidget#workspaceListRow[active="true"] QLabel#workspaceListName { color: #b3c5ff; }
QPushButton#workspaceListDeleteButton {
  background: #2b1d1d; border: 1px solid #5b2929; color: #f56c6c;
  padding: 3px 7px; font-size: 11px;
}
QPushButton#workspaceListDeleteButton:hover { border-color: #f56c6c; background: #3a2222; }
QPushButton#workspaceSettingsButton {
  background: transparent; border: 0; border-top: 1px solid #353947;
  border-radius: 0; color: #cfd3dc; padding: 14px 10px; text-align: left;
}
QPushButton[role="navigation"] {
  background: transparent; border: 0; border-left: 3px solid transparent;
  border-radius: 0; color: #cfd3dc; padding: 10px 16px;
  text-align: left; font-size: 15px; font-weight: 400;
}
QPushButton[role="navigation"]:hover { background: #262727; color: #e5eaf3; }
QPushButton[role="navigation"][active="true"] {
  background: #18222c; border-left-color: #409eff; color: #409eff; font-weight: 500;
}
QWidget[role="navigationRow"] {
  background: transparent; border: 0; border-left: 3px solid transparent;
}
QWidget[role="navigationRow"][hovered="true"] { background: #262727; }
QWidget[role="navigationRow"][active="true"] {
  background: #18222c; border-left-color: #409eff;
}
QPushButton[role="navigationRowMain"] {
  background: transparent; border: 0; border-radius: 0; color: #cfd3dc;
  padding: 10px 13px; text-align: left; font-size: 15px; font-weight: 400;
}
QPushButton[role="navigationExpand"] {
  background: transparent; border: 0; border-radius: 0; color: #8d9095;
  padding: 0; font-size: 18px;
}
QPushButton[role="navigationExpand"]:hover { background: transparent; }
QWidget[role="navigationRow"][hovered="true"] QPushButton { color: #e5eaf3; }
QWidget[role="navigationRow"][active="true"] QPushButton { color: #409eff; }
QPushButton[role="subnavigation"] {
  background: transparent; border: 0; border-left: 3px solid transparent;
  border-radius: 0; color: #a3a6ad; padding: 8px 16px 8px 46px;
  text-align: left; font-size: 13px;
}
QPushButton[role="subnavigation"]:hover { background: #262727; color: #e5eaf3; }
QPushButton[role="subnavigation"][active="true"] { color: #409eff; }
QFrame#navigationDivider { background: #414243; border: 0; max-height: 1px; }
QFrame#topBar { background: #1d1e1f; border-bottom: 1px solid #414243; }
QLabel#pageTitle { color: #e5eaf3; font-size: 20px; font-weight: 600; }
QLabel#pageSubtitle { color: #a3a6ad; font-size: 12px; }
QLabel#mono, QLabel#metricValue, QLabel#statusValue {
  font-family: "__TRAFFICVERSE_MONO_FONT__";
}
QLabel#metricValue { color: #e5eaf3; font-size: 21px; font-weight: 600; }
AutomationLevelBarChart {
  qproperty-l0Color: #f56c6c; qproperty-l1Color: #e6a23c; qproperty-l2Color: #f5cd50;
  qproperty-l3Color: #409eff; qproperty-l4Color: #67c23a; qproperty-l5Color: #a78bfa;
}
QLabel#statusBadge {
  background: #1c2518; border: 1px solid #2b4b23; border-radius: 4px;
  color: #67c23a; padding: 5px 9px; font-size: 12px; font-weight: 500;
}
QLabel#connectionBadge {
  background: #18222c; border: 1px solid #284a6d; border-radius: 4px;
  color: #409eff; padding: 5px 9px;
}
QLabel#notice {
  background: #18222c; border: 1px solid #284a6d; border-radius: 4px;
  color: #79bbff; padding: 9px 12px;
}
QLabel#notice[level="error"] { background: #2b1d1d; border-color: #5b2929; color: #f56c6c; }
QLabel#notice[level="success"] { background: #1c2518; border-color: #2b4b23; color: #67c23a; }
QLabel#notice[level="warning"] { background: #2b2518; border-color: #5c4824; color: #e6a23c; }
QFrame#panel, QFrame#metricCard, QFrame#listCard, QFrame#assetDirectory {
  background: #1d1e1f; border: 1px solid #414243; border-radius: 4px;
}
QFrame#workspacePreview {
  background: #10131c; border: 1px solid #353947; border-radius: 6px;
  min-height: 300px;
}
QFrame#projectEditableField {
  background: #18191a; border: 1px solid #363637; border-radius: 4px;
}
QFrame#projectEditableField:hover, QFrame#projectEditableField:focus {
  background: #18222c; border-color: #409eff;
}
QLabel#projectFieldLabel { color: #a3a6ad; font-size: 12px; }
QLabel#projectNameValue { color: #e5eaf3; font-size: 18px; font-weight: 600; }
QLabel#projectDescriptionValue { color: #cfd3dc; font-size: 14px; }
QWidget#projectSimulationActions { background: transparent; }
QToolButton#projectSimulationAction {
  background: transparent; border: 0; border-radius: 4px; padding: 4px;
}
QToolButton#projectSimulationAction:hover { background: #2b2b2c; }
QLabel#projectSimulationStatus { font-size: 12px; font-weight: 500; }
QLabel#projectSimulationStatus[state="running"] { color: #409eff; }
QLabel#projectSimulationStatus[state="completed"] { color: #67c23a; }
QLabel#projectSimulationStatus[state="failed"] { color: #f56c6c; }
QWidget#simulationConfigurationBody, QFrame#simulationConfigurationSection,
QFrame#simulationRightColumn { background: transparent; border: 0; }
QLabel#simulationSectionTitle { color: #8b93a7; font-size: 11px; font-weight: 600; }
QLabel#simulationFieldLabel { color: #c9ced9; font-size: 11px; font-weight: 500; }
QLineEdit#sceneNameInput, QTextEdit#sceneDescriptionInput {
  background: #090c12; border-color: #3a4150; color: #eef1f7; font-size: 13px;
}
QLineEdit#sceneNameInput:focus, QTextEdit#sceneDescriptionInput:focus { border-color: #409eff; }
QFrame#automationConfigurationRow {
  background: #11151f; border: 1px solid #343b4a; border-radius: 4px;
}
QFrame#automationConfigurationRow QComboBox,
QFrame#automationConfigurationRow QSpinBox { background: #090c12; }
QSpinBox#automationVehicleCount { padding-right: 38px; qproperty-arrowColor: #cfd3dc; }
QSpinBox#automationVehicleCount::up-button,
QSpinBox#automationVehicleCount::down-button {
  subcontrol-origin: border; width: 34px; border-left: 1px solid #343b4a;
}
QSpinBox#automationVehicleCount::up-button {
  subcontrol-position: top right; border-bottom: 1px solid #343b4a;
}
QSpinBox#automationVehicleCount::down-button { subcontrol-position: bottom right; }
QSpinBox#automationVehicleCount::up-arrow,
QSpinBox#automationVehicleCount::down-arrow { image: none; width: 0; height: 0; }
QSpinBox#automationVehicleCount::up-button:hover,
QSpinBox#automationVehicleCount::down-button:hover { background: #18222c; }
QSpinBox#automationVehicleCount[macosStepper="true"] { padding-right: 44px; }
QSpinBox#automationVehicleCount[macosStepper="true"]::up-button,
QSpinBox#automationVehicleCount[macosStepper="true"]::down-button { width: 40px; }
QPushButton#automationRowAction { min-width: 28px; max-width: 28px; padding: 6px 0; }
QPushButton#automationRowAction[action="remove"] { color: #7f8799; }
QPushButton#addAutomationCategoryButton {
  background: transparent; border: 1px dashed #343b4a; color: #8b93a7; padding: 9px;
}
QPushButton#addAutomationCategoryButton:hover { border-color: #409eff; color: #79bbff; }
QLabel#automationTotal {
  background: #082c34; border: 1px solid #0f5965; border-radius: 3px;
  color: #36cfc9; padding: 3px 7px; font-family: "__TRAFFICVERSE_MONO_FONT__";
}
QWebEngineView#simulationMapPreview {
  background: #090d15; border: 1px solid #343b4a; border-radius: 4px;
}
QLabel#simulationMapStatus { color: #7f8799; font-size: 11px; }
QTimeEdit#simulationDurationTime {
  background: #090c12; border: 1px solid #3a4150; border-radius: 4px;
  color: #eef1f7; padding: 7px 12px; font-family: "__TRAFFICVERSE_MONO_FONT__";
}
QTimeEdit#simulationDurationTime:hover, QTimeEdit#simulationDurationTime:focus {
  border-color: #409eff;
}
QLabel#dialogTitle { color: #e5eaf3; font-size: 19px; font-weight: 600; }
QLabel#workspaceDeleteError {
  background: #2b1d1d; border: 1px solid #5b2929; border-radius: 4px;
  color: #f56c6c; padding: 7px 9px;
}
QDialog#workspaceEditDialog, QDialog#workspaceDeleteDialog {
  background: #272a33; border: 1px solid #4c5264;
}
QFrame#panelAccent { background: #1d1e1f; border: 1px solid #3375b9; border-radius: 4px; }
QLabel#panelTitle { color: #e5eaf3; font-size: 14px; font-weight: 600; }
QLabel#panelKicker { color: #909399; font-size: 11px; font-weight: 500; }
QLabel#compatibilityTag {
  background: #18222c; border: 1px solid #284a6d; border-radius: 4px;
  color: #79bbff; padding: 5px 9px;
}
QLabel#assetStatusBadge {
  background: #1c2518; border: 1px solid #2b4b23; border-radius: 4px;
  color: #67c23a; padding: 5px 9px;
}
QLabel#emptyIcon { color: #6c6e72; font-size: 40px; font-weight: 500; }
QLabel#emptyTitle { color: #cfd3dc; font-size: 17px; font-weight: 500; }
QLabel#carlaStatus { background: #18191a; color: #a3a6ad; border-radius: 4px; }
QPushButton, QComboBox, QLineEdit, QTextEdit, QSpinBox, QDoubleSpinBox {
  background: #1d1e1f; border: 1px solid #4c4d4f; border-radius: 4px;
  color: #cfd3dc; padding: 7px 12px; selection-background-color: #3375b9;
}
QPushButton:hover, QComboBox:hover, QLineEdit:hover, QTextEdit:hover,
QSpinBox:hover, QDoubleSpinBox:hover { border-color: #409eff; }
QPushButton:pressed { background: #262727; }
QPushButton:disabled { color: #6c6e72; background: #262727; border-color: #363637; }
QPushButton#primaryButton { background: #409eff; border-color: #409eff; color: #ffffff; font-weight: 500; }
QPushButton#primaryButton:hover { background: #66b1ff; border-color: #66b1ff; }
QPushButton[role="primaryAction"] { background: #409eff; border-color: #409eff; color: #ffffff; font-weight: 500; }
QPushButton[role="primaryAction"]:hover { background: #66b1ff; border-color: #66b1ff; }
QPushButton#dangerButton { background: #2b1d1d; border-color: #5b2929; color: #f56c6c; }
QPushButton#dangerButton:hover { background: #3a2222; border-color: #f56c6c; }
QPushButton#restartButton { background: #2b2518; border-color: #5c4824; color: #e6a23c; }
QPushButton#restartButton:hover { background: #3a301e; border-color: #e6a23c; }
QPushButton#speedButton { padding: 6px 11px; }
QPushButton#speedButton:checked { background: #18222c; border-color: #409eff; color: #409eff; }
QComboBox::drop-down { border: 0; width: 24px; }
QComboBox QAbstractItemView { background: #1d1e1f; border: 1px solid #4c4d4f; selection-background-color: #3375b9; }
QScrollArea { border: 0; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }
QSplitter::handle { background: #2b2b2c; width: 8px; }
QProgressBar { background: #363637; border: 0; border-radius: 2px; max-height: 4px; }
QProgressBar::chunk { background: #409eff; border-radius: 2px; }
QTableWidget {
  background: #1d1e1f; alternate-background-color: #18191a;
  border: 1px solid #414243; border-radius: 4px;
  gridline-color: #363637; color: #cfd3dc;
}
QTableWidget#projectSimulationTable { min-height: 280px; }
QTreeWidget {
  background: #1d1e1f; alternate-background-color: #18191a;
  border: 1px solid #414243; border-radius: 4px; color: #cfd3dc;
}
QTreeWidget::item { padding: 5px 4px; }
QTreeWidget::item:hover { background: #262727; }
QTreeWidget::item:selected { background: #18222c; color: #409eff; }
QHeaderView::section {
  background: #262727; border: 0; border-bottom: 1px solid #414243;
  color: #a3a6ad; padding: 8px; font-weight: 500;
}
QTabWidget::pane { border: 1px solid #414243; border-radius: 4px; }
QTabBar::tab { background: #1d1e1f; color: #a3a6ad; padding: 8px 14px; }
QTabBar::tab:selected { color: #409eff; border-bottom: 2px solid #409eff; }

QPushButton[role="historyEntry"] {
  background: transparent; border: 0; border-left: 1px solid #343b4a;
  border-radius: 0; color: #8b93a7; padding: 7px 5px 7px 25px;
  text-align: left; font-size: 12px; font-family: "__TRAFFICVERSE_MONO_FONT__";
}
QPushButton[role="historyEntry"]:hover { background: #151b29; color: #cdd6e8; }
QPushButton[role="historyEntry"][active="true"] {
  background: #11192a; border: 1px solid #29426f; border-left: 3px solid #6f8dff;
  border-radius: 4px; color: #e6ebf5; font-weight: 600;
}
QWidget#dataReplayPage, QWidget#replayBody { background: #11141d; }
QLabel#replayTimestamp {
  background: #1c2432; border: 1px solid #303a4b; border-radius: 6px;
  color: #12d7f4; padding: 7px 11px; font-family: "__TRAFFICVERSE_MONO_FONT__";
  font-size: 12px; font-weight: 600;
}
QPushButton#replayRestartButton, QPushButton#replayBackButton, QPushButton#replayExportButton {
  padding: 8px 14px; font-weight: 600;
}
QFrame#replaySummaryBar, QFrame#replaySection {
  background: #1b1e27; border: 1px solid #343a48; border-radius: 10px;
}
QWidget#replaySummaryItem { background: transparent; border-right: 1px solid #303542; }
QLabel#replaySummaryLabel, QLabel#replayMetricLabel, QLabel#replayMetricUnit,
QLabel#replayChartRange { color: #858da0; font-size: 11px; }
QLabel#replaySummaryValue {
  color: #d8dce7; font-size: 12px; font-weight: 600;
  font-family: "__TRAFFICVERSE_MONO_FONT__";
}
QLabel#replaySummaryValue[summaryKey="duration"] { color: #12d7f4; font-size: 15px; }
QLabel#replaySummaryValue[summaryKey="status"] { color: #2fdf84; }
QLabel#replaySectionTitle { color: #d8dce7; font-size: 16px; font-weight: 700; }
QFrame#replayMetricCard, QFrame#replayChartCard {
  background: #1c1f28; border: 1px solid #343946; border-radius: 8px;
}
QLabel#replayMetricValue {
  color: #e1e4ec; font-size: 25px; font-weight: 700;
  font-family: "__TRAFFICVERSE_MONO_FONT__";
}
QLabel#replayMetricValue[tone="primary"] { color: #12d7f4; }
QLabel#replayMetricValue[tone="warning"] { color: #ff9c78; }
QLabel#replayChartTitle { color: #d8dce7; font-size: 12px; font-weight: 600; }
QFrame#replayTrendChart { background: transparent; border: 0; }
QFrame#replayRoadCanvas {
  background: #09101a; border: 1px solid #263140; border-radius: 8px;
}
QPushButton#replayMapModeButton {
  background: #242731; border: 1px solid #383e4c; color: #aab1c0;
  padding: 6px 9px; font-size: 11px;
}
QPushButton#replayMapModeButton:checked {
  background: #263252; border-color: #536ead; color: #86a0ff;
}

/* Traffic scenario navigation and detail page */
QPushButton[role="scenarioEntry"] {
  background: transparent; border: 0; border-left: 1px solid #343b4a;
  border-radius: 0; color: #8b93a7; padding: 3px 8px 3px 25px;
  text-align: left; font-size: 12px;
}
QPushButton[role="scenarioEntry"]:hover { background: #151b29; color: #cdd6e8; }
QPushButton[role="scenarioEntry"][active="true"] {
  background: #11192a; border: 1px solid #29426f; border-left: 3px solid #00a8ff;
  border-radius: 4px; color: #e6ebf5; font-weight: 600;
}
QWidget#trafficScenePage, QWidget#trafficSceneBody { background: #11141d; }
QWidget#trafficSceneHeaderActions { background: transparent; }
QScrollArea#trafficSceneScroll { border: 0; background: #11141d; }
QFrame#trafficSceneHero {
  background: #090d14; border: 1px solid #343a48; border-radius: 6px;
}
QLabel#trafficSceneTitle { color: #ffffff; font-size: 23px; font-weight: 700; }
QLabel#trafficSceneIncident { color: #c8cfdb; font-size: 12px; }
QLabel#trafficSceneMeta {
  background: rgba(15, 21, 32, 205); border: 1px solid rgba(87, 100, 124, 130);
  border-radius: 3px; color: #c7cfdd; padding: 4px 8px; font-size: 10px;
}
QLabel#trafficSceneAvailability {
  border: 1px solid #354052; border-radius: 4px; color: #8b93a7;
  min-width: 68px; padding: 5px 8px; font-size: 11px; font-weight: 700;
}
QLabel#trafficSceneAvailability[state="ready"] {
  background: #13271e; border-color: #245e3e; color: #39d98a;
}
QLabel#trafficSceneAvailability[state="missing"] {
  background: #2b171b; border-color: #6b2c35; color: #ff6b75;
}
QLabel#trafficSceneContentTitle, QLabel#trafficScenePanelTitle {
  color: #edf1f8; font-size: 15px; font-weight: 700;
}
QLabel#trafficSceneBehaviorSummary { color: #8f98aa; font-size: 11px; }
QFrame#trafficSceneLevelCard {
  background: #171a23; border: 1px solid #323846; border-radius: 5px;
}
QFrame#trafficScenePanel {
  background: #1b1e27; border: 1px solid #343a48; border-radius: 6px;
}
QWebEngineView#trafficSceneMapPreview {
  background: #090d14; border: 1px solid #303746; border-radius: 5px;
}
QLabel#trafficSceneLevel { font-size: 12px; font-weight: 800; }
QLabel#trafficSceneLevel[level="L0"] { color: #ff6670; }
QLabel#trafficSceneLevel[level="L1"] { color: #ff8a3d; }
QLabel#trafficSceneLevel[level="L2"] { color: #f5c84c; }
QLabel#trafficSceneLevel[level="L3"] { color: #32b8ff; }
QLabel#trafficSceneLevel[level="L4"] { color: #31d7bd; }
QLabel#trafficSceneLevel[level="L5"] { color: #8da2ff; }
QLabel#trafficSceneLevelDescription { color: #aab2c2; font-size: 11px; }
QLabel#trafficSceneChartLabel { color: #aeb6c6; font-size: 11px; font-weight: 600; }
QWidget#trafficSceneSpeedChart, QWidget#trafficSceneCollisionChart {
  background: transparent; color: #dfe5f1;
  qproperty-l0Color: #f56c6c; qproperty-l1Color: #e6a23c; qproperty-l2Color: #f5c84c;
  qproperty-l3Color: #409eff; qproperty-l4Color: #67c23a; qproperty-l5Color: #9b82ee;
}
QPushButton#trafficSceneConfigureButton {
  background: #252933; border: 1px solid #414858; color: #d0d6e2;
  min-height: 31px; padding: 5px 14px;
}
QPushButton#trafficSceneConfigureButton:hover { border-color: #0066ff; color: #ffffff; }
QPushButton#trafficSceneLaunchButton {
  background: #0066ff; border: 1px solid #2380ff; color: #ffffff;
  min-height: 31px; padding: 5px 16px; font-weight: 700;
}
QPushButton#trafficSceneLaunchButton:hover { background: #1677ff; }
QPushButton#trafficSceneConfigureButton:disabled,
QPushButton#trafficSceneLaunchButton:disabled {
  background: #20232b; border-color: #303641; color: #666e7e;
}
