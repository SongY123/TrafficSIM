<?xml version="1.0" encoding="UTF-8"?>
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="mixed-automation-occasional-accident.net.xml" />
        <route-files value="mixed-automation-occasional-accident.rou.xml" />
        <gui-settings-file value="mixed-automation-occasional-accident.view.xml" />
    </input>
    <time>
        <begin value="0" />
        <end value="120" />
        <step-length value="0.05" />
    </time>
    <processing>
        <time-to-teleport value="-1" />
        <lanechange.duration value="2.0" />
        <collision.action value="warn" />
        <collision.mingap-factor value="0" />
        <collision.stoptime value="0" />
    </processing>
    <report>
        <verbose value="false" />
        <no-step-log value="true" />
    </report>
</configuration>
