{
  "$defs": {
    "AutomationConfig": {
      "additionalProperties": false,
      "properties": {
        "proportions": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "$ref": "#/$defs/AutomationLevel"
          },
          "title": "Proportions",
          "type": "object"
        }
      },
      "required": [
        "proportions"
      ],
      "title": "AutomationConfig",
      "type": "object"
    },
    "AutomationLevel": {
      "enum": [
        "HUMAN",
        "ACC",
        "L0",
        "L1",
        "L2",
        "L3",
        "L4",
        "L5"
      ],
      "title": "AutomationLevel",
      "type": "string"
    },
    "CarlaConfig": {
      "additionalProperties": false,
      "properties": {
        "blueprint_filter": {
          "default": "vehicle.*",
          "minLength": 1,
          "title": "Blueprint Filter",
          "type": "string"
        },
        "endpoint_mode": {
          "const": "local_server",
          "default": "local_server",
          "title": "Endpoint Mode",
          "type": "string"
        },
        "expected_version": {
          "minLength": 1,
          "title": "Expected Version",
          "type": "string"
        },
        "fallback_blueprints": {
          "default": [
            "vehicle.tesla.model3",
            "vehicle.audi.tt"
          ],
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Fallback Blueprints",
          "type": "array"
        },
        "host": {
          "minLength": 1,
          "title": "Host",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/RequirementMode"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "spawn_retries": {
          "default": 2,
          "maximum": 10,
          "minimum": 0,
          "title": "Spawn Retries",
          "type": "integer"
        },
        "step_ms": {
          "default": 50,
          "exclusiveMinimum": 0,
          "title": "Step Ms",
          "type": "integer"
        },
        "timeout_s": {
          "exclusiveMinimum": 0.0,
          "title": "Timeout S",
          "type": "number"
        },
        "worker_threads": {
          "default": 0,
          "minimum": 0,
          "title": "Worker Threads",
          "type": "integer"
        }
      },
      "required": [
        "mode",
        "host",
        "port",
        "timeout_s",
        "expected_version"
      ],
      "title": "CarlaConfig",
      "type": "object"
    },
    "CarlaViewConfig": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "native_window",
          "default": "native_window",
          "title": "Mode",
          "type": "string"
        },
        "native_window_id_env": {
          "default": "TRAFFICVERSE_CARLA_WINDOW_ID",
          "pattern": "^[A-Z][A-Z0-9_]+$",
          "title": "Native Window Id Env",
          "type": "string"
        }
      },
      "title": "CarlaViewConfig",
      "type": "object"
    },
    "LoggingConfig": {
      "additionalProperties": false,
      "properties": {
        "parquet_batch_rows": {
          "exclusiveMinimum": 0,
          "title": "Parquet Batch Rows",
          "type": "integer"
        },
        "trajectory_hz": {
          "exclusiveMinimum": 0,
          "title": "Trajectory Hz",
          "type": "integer"
        }
      },
      "required": [
        "trajectory_hz",
        "parquet_batch_rows"
      ],
      "title": "LoggingConfig",
      "type": "object"
    },
    "MapRegistrationConfig": {
      "additionalProperties": false,
      "properties": {
        "manifest": {
          "minLength": 1,
          "title": "Manifest",
          "type": "string"
        }
      },
      "required": [
        "manifest"
      ],
      "title": "MapRegistrationConfig",
      "type": "object"
    },
    "ReplayConfig": {
      "additionalProperties": false,
      "properties": {
        "snapshot_interval_ms": {
          "exclusiveMinimum": 0,
          "title": "Snapshot Interval Ms",
          "type": "integer"
        }
      },
      "required": [
        "snapshot_interval_ms"
      ],
      "title": "ReplayConfig",
      "type": "object"
    },
    "RequirementMode": {
      "enum": [
        "required",
        "optional",
        "disabled"
      ],
      "title": "RequirementMode",
      "type": "string"
    },
    "RoiConfig": {
      "additionalProperties": false,
      "properties": {
        "buffer_m": {
          "exclusiveMinimum": 0.0,
          "title": "Buffer M",
          "type": "number"
        },
        "focus": {
          "$ref": "#/$defs/RoiFocusConfig"
        },
        "max_actors": {
          "default": 200,
          "exclusiveMinimum": 0,
          "title": "Max Actors",
          "type": "integer"
        },
        "radius_m": {
          "exclusiveMinimum": 0.0,
          "title": "Radius M",
          "type": "number"
        }
      },
      "required": [
        "radius_m",
        "buffer_m",
        "focus"
      ],
      "title": "RoiConfig",
      "type": "object"
    },
    "RoiFocusConfig": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "fixed",
            "follow_vehicle"
          ],
          "title": "Mode",
          "type": "string"
        },
        "vehicle_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vehicle Id"
        },
        "x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y"
        }
      },
      "required": [
        "mode"
      ],
      "title": "RoiFocusConfig",
      "type": "object"
    },
    "ScenarioIdentityConfig": {
      "additionalProperties": false,
      "properties": {
        "map_id": {
          "minLength": 1,
          "title": "Map Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "seed": {
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "map_id",
        "seed"
      ],
      "title": "ScenarioIdentityConfig",
      "type": "object"
    },
    "SimulationConfig": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "exclusiveMinimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "speed_multiplier": {
          "exclusiveMinimum": 0.0,
          "title": "Speed Multiplier",
          "type": "number"
        },
        "start_time_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Start Time Ms",
          "type": "integer"
        },
        "step_ms": {
          "exclusiveMinimum": 0,
          "title": "Step Ms",
          "type": "integer"
        }
      },
      "required": [
        "step_ms",
        "duration_ms",
        "speed_multiplier"
      ],
      "title": "SimulationConfig",
      "type": "object"
    },
    "SumoConfig": {
      "additionalProperties": false,
      "description": "SUMO/TraCI endpoint or managed local process used as the traffic truth source.",
      "properties": {
        "begin_time_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Begin Time Ms",
          "type": "integer"
        },
        "binary": {
          "default": "sumo",
          "minLength": 1,
          "title": "Binary",
          "type": "string"
        },
        "config_file": {
          "minLength": 1,
          "title": "Config File",
          "type": "string"
        },
        "connect_retries": {
          "default": 3,
          "maximum": 100,
          "minimum": 0,
          "title": "Connect Retries",
          "type": "integer"
        },
        "expected_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Version"
        },
        "freeze_collisions": {
          "default": false,
          "title": "Freeze Collisions",
          "type": "boolean"
        },
        "host": {
          "default": "127.0.0.1",
          "minLength": 1,
          "title": "Host",
          "type": "string"
        },
        "launch_mode": {
          "default": "external",
          "enum": [
            "external",
            "managed"
          ],
          "title": "Launch Mode",
          "type": "string"
        },
        "output_directory": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Directory"
        },
        "port": {
          "default": 8813,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "provider": {
          "const": "sumo",
          "default": "sumo",
          "title": "Provider",
          "type": "string"
        },
        "step_ms": {
          "default": 50,
          "exclusiveMinimum": 0,
          "title": "Step Ms",
          "type": "integer"
        },
        "tls_manager": {
          "const": "sumo",
          "default": "sumo",
          "title": "Tls Manager",
          "type": "string"
        }
      },
      "required": [
        "config_file"
      ],
      "title": "SumoConfig",
      "type": "object"
    },
    "TrafficConfig": {
      "additionalProperties": false,
      "properties": {
        "network": {
          "minLength": 1,
          "title": "Network",
          "type": "string"
        },
        "routes": {
          "minLength": 1,
          "title": "Routes",
          "type": "string"
        },
        "signals": {
          "minLength": 1,
          "title": "Signals",
          "type": "string"
        },
        "vehicles": {
          "exclusiveMinimum": 0,
          "title": "Vehicles",
          "type": "integer"
        }
      },
      "required": [
        "network",
        "routes",
        "signals",
        "vehicles"
      ],
      "title": "TrafficConfig",
      "type": "object"
    },
    "UiConfig": {
      "additionalProperties": false,
      "properties": {
        "api_url": {
          "default": "http://127.0.0.1:8000",
          "minLength": 1,
          "title": "Api Url",
          "type": "string"
        },
        "carla_view": {
          "$ref": "#/$defs/CarlaViewConfig"
        }
      },
      "title": "UiConfig",
      "type": "object"
    },
    "WeatherConfig": {
      "additionalProperties": false,
      "properties": {
        "preset": {
          "minLength": 1,
          "title": "Preset",
          "type": "string"
        }
      },
      "required": [
        "preset"
      ],
      "title": "WeatherConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "automation": {
      "$ref": "#/$defs/AutomationConfig"
    },
    "carla": {
      "$ref": "#/$defs/CarlaConfig"
    },
    "logging": {
      "$ref": "#/$defs/LoggingConfig"
    },
    "map_registration": {
      "$ref": "#/$defs/MapRegistrationConfig"
    },
    "replay": {
      "$ref": "#/$defs/ReplayConfig"
    },
    "roi": {
      "$ref": "#/$defs/RoiConfig"
    },
    "scenario": {
      "$ref": "#/$defs/ScenarioIdentityConfig"
    },
    "schema_version": {
      "const": "1.2",
      "default": "1.2",
      "title": "Schema Version",
      "type": "string"
    },
    "simulation": {
      "$ref": "#/$defs/SimulationConfig"
    },
    "sumo": {
      "$ref": "#/$defs/SumoConfig"
    },
    "traffic": {
      "$ref": "#/$defs/TrafficConfig"
    },
    "ui": {
      "$ref": "#/$defs/UiConfig"
    },
    "weather": {
      "$ref": "#/$defs/WeatherConfig"
    }
  },
  "required": [
    "scenario",
    "simulation",
    "traffic",
    "sumo",
    "automation",
    "roi",
    "carla",
    "weather",
    "map_registration",
    "logging",
    "replay"
  ],
  "title": "ScenarioConfig",
  "type": "object"
}
