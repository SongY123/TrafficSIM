{
  "$defs": {
    "AutomationConfig": {
      "additionalProperties": false,
      "properties": {
        "proportions": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "$ref": "#/$defs/AutomationLevel"
          },
          "title": "Proportions",
          "type": "object"
        }
      },
      "required": [
        "proportions"
      ],
      "title": "AutomationConfig",
      "type": "object"
    },
    "AutomationLevel": {
      "enum": [
        "HUMAN",
        "ACC",
        "L2",
        "L3",
        "L4"
      ],
      "title": "AutomationLevel",
      "type": "string"
    },
    "LoggingConfig": {
      "additionalProperties": false,
      "properties": {
        "parquet_batch_rows": {
          "exclusiveMinimum": 0,
          "title": "Parquet Batch Rows",
          "type": "integer"
        },
        "trajectory_hz": {
          "exclusiveMinimum": 0,
          "title": "Trajectory Hz",
          "type": "integer"
        }
      },
      "required": [
        "trajectory_hz",
        "parquet_batch_rows"
      ],
      "title": "LoggingConfig",
      "type": "object"
    },
    "ReplayConfig": {
      "additionalProperties": false,
      "properties": {
        "snapshot_interval_ms": {
          "exclusiveMinimum": 0,
          "title": "Snapshot Interval Ms",
          "type": "integer"
        }
      },
      "required": [
        "snapshot_interval_ms"
      ],
      "title": "ReplayConfig",
      "type": "object"
    },
    "ScenarioIdentityConfig": {
      "additionalProperties": false,
      "properties": {
        "map_id": {
          "minLength": 1,
          "title": "Map Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "seed": {
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "map_id",
        "seed"
      ],
      "title": "ScenarioIdentityConfig",
      "type": "object"
    },
    "SimulationConfig": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "exclusiveMinimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "speed_multiplier": {
          "exclusiveMinimum": 0.0,
          "title": "Speed Multiplier",
          "type": "number"
        },
        "step_ms": {
          "exclusiveMinimum": 0,
          "title": "Step Ms",
          "type": "integer"
        }
      },
      "required": [
        "step_ms",
        "duration_ms",
        "speed_multiplier"
      ],
      "title": "SimulationConfig",
      "type": "object"
    },
    "SumoConfig": {
      "additionalProperties": false,
      "description": "External SUMO/TraCI endpoint used as the production traffic truth source.",
      "properties": {
        "config_file": {
          "minLength": 1,
          "title": "Config File",
          "type": "string"
        },
        "connect_retries": {
          "default": 3,
          "maximum": 100,
          "minimum": 0,
          "title": "Connect Retries",
          "type": "integer"
        },
        "expected_version": {
          "default": "1.27.1",
          "minLength": 1,
          "title": "Expected Version",
          "type": "string"
        },
        "host": {
          "default": "127.0.0.1",
          "minLength": 1,
          "title": "Host",
          "type": "string"
        },
        "launch_mode": {
          "const": "external",
          "default": "external",
          "title": "Launch Mode",
          "type": "string"
        },
        "port": {
          "default": 8813,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "provider": {
          "const": "sumo",
          "default": "sumo",
          "title": "Provider",
          "type": "string"
        },
        "step_ms": {
          "default": 50,
          "exclusiveMinimum": 0,
          "title": "Step Ms",
          "type": "integer"
        },
        "tls_manager": {
          "const": "sumo",
          "default": "sumo",
          "title": "Tls Manager",
          "type": "string"
        }
      },
      "required": [
        "config_file"
      ],
      "title": "SumoConfig",
      "type": "object"
    },
    "TrafficConfig": {
      "additionalProperties": false,
      "properties": {
        "network": {
          "minLength": 1,
          "title": "Network",
          "type": "string"
        },
        "routes": {
          "minLength": 1,
          "title": "Routes",
          "type": "string"
        },
        "signals": {
          "minLength": 1,
          "title": "Signals",
          "type": "string"
        },
        "vehicles": {
          "exclusiveMinimum": 0,
          "title": "Vehicles",
          "type": "integer"
        }
      },
      "required": [
        "network",
        "routes",
        "signals",
        "vehicles"
      ],
      "title": "TrafficConfig",
      "type": "object"
    },
    "UiConfig": {
      "additionalProperties": false,
      "properties": {
        "api_url": {
          "default": "http://127.0.0.1:8000",
          "minLength": 1,
          "title": "Api Url",
          "type": "string"
        }
      },
      "title": "UiConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "automation": {
      "$ref": "#/$defs/AutomationConfig"
    },
    "logging": {
      "$ref": "#/$defs/LoggingConfig"
    },
    "replay": {
      "$ref": "#/$defs/ReplayConfig"
    },
    "scenario": {
      "$ref": "#/$defs/ScenarioIdentityConfig"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "simulation": {
      "$ref": "#/$defs/SimulationConfig"
    },
    "sumo": {
      "$ref": "#/$defs/SumoConfig"
    },
    "traffic": {
      "$ref": "#/$defs/TrafficConfig"
    },
    "ui": {
      "$ref": "#/$defs/UiConfig"
    }
  },
  "required": [
    "scenario",
    "simulation",
    "traffic",
    "sumo",
    "automation",
    "logging",
    "replay"
  ],
  "title": "ScenarioConfig",
  "type": "object"
}
